{
  "name": "@rupu/boundary",
  "version": "0.1.0",
  "description": "Runtime boundary between decisions and real-world effects.",
  "type": "module",
  "license": "Apache-2.0",
  "private": false,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./testing": {
      "types": "./dist/src/testing.d.ts",
      "import": "./dist/src/testing.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EmanuelCorreaAR/rupu-boundary.git"
  },
  "bugs": {
    "url": "https://github.com/EmanuelCorreaAR/rupu-boundary/issues"
  },
  "homepage": "https://github.com/EmanuelCorreaAR/rupu-boundary#readme",
  "keywords": [
    "boundary",
    "occ",
    "capabilities",
    "agents",
    "typescript"
  ]
}
